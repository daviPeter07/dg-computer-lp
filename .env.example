# Integração com o ERP de estoque. Sem ERP_API_URL o site usa os dados de demonstração.
ERP_API_URL=
ERP_API_TOKEN=
# Segredo que o ERP envia no cabeçalho x-webhook-secret ao chamar /api/estoque/revalidar
ERP_WEBHOOK_SECRET=
# Domínio onde o ERP hospeda as fotos dos produtos (ex.: erp.dgcomputer.com.br)
ERP_IMAGE_HOST=
